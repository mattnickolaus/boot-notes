{
  "manifest_version": 3,
  "name": "Boot Notes",
  "version": "2.0",
  "description": "Extracts Boot.dev lesson content as Markdown and copies it to clipboard.",
  "permissions": [
      "activeTab",
      "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
	"128": "icons/icon128.png"
    }
  },
  "icons": {
      "128": "icons/icon128.png"
  },
  "content_scripts": [
      {
	  "matches": ["https://*.boot.dev/*"],
	  "js": ["content.js"]
      }
  ]
}

